# Thor release settings. Privacy behavior is implemented by Thor policy and
# Chromium APIs; this file has no third-party browser dependency.
blink_symbol_level = 0
symbol_level = 1
is_debug = false
is_component_build = false
is_official_build = true

# Chromium 151 release hardening. These are declared by the pinned tree.
use_thin_lto = true
init_stack_vars = true
init_stack_vars_zero = true
use_partition_alloc_as_malloc = true
enable_backup_ref_ptr_support = true
enable_backup_ref_ptr_feature_flag = true
