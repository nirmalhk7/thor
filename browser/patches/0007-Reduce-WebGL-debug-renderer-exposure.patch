From 16dcd77eb28c7796ba6ab60821d900986dfbcbe8 Mon Sep 17 00:00:00 2001
From: Thor Browser <engineering@thor.local>
Date: Fri, 31 Jul 2026 22:38:50 -0600
Subject: [PATCH 7/7] Reduce WebGL debug renderer exposure

Propagate a renderer-only reduction switch for Stealth, Hardened, empty, and
unknown Thor privacy-profile values. Blink then removes
WEBGL_debug_renderer_info from supported extensions and refuses enablement,
covering document, iframe, and worker/OffscreenCanvas WebGL contexts without
JavaScript prototype mutation. DevHost remains truthful for graphics debugging.

This deliberately covers only the unmasked GPU vendor/renderer surface; it is
not broad anti-fingerprinting parity.

---
 .../browser/chrome_content_browser_client.cc  |  9 +++++++
 third_party/blink/common/switches.cc          |  5 ++++
 third_party/blink/public/common/switches.h    |  1 +
 third_party/blink/renderer/modules/BUILD.gn   |  1 +
 .../blink/renderer/modules/webgl/BUILD.gn     |  1 +
 .../modules/webgl/thor_webgl_privacy.h        | 21 ++++++++++++++++
 .../modules/webgl/thor_webgl_privacy_test.cc  | 24 +++++++++++++++++++
 .../webgl/webgl_rendering_context_base.cc     |  6 +++++
 8 files changed, 68 insertions(+)
 create mode 100644 third_party/blink/renderer/modules/webgl/thor_webgl_privacy.h
 create mode 100644 third_party/blink/renderer/modules/webgl/thor_webgl_privacy_test.cc

diff --git a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
index 5c25d7d..e947fdf 100644
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -2902,6 +2902,15 @@ void ChromeContentBrowserClient::AppendExtraCommandLineSwitches(
 #endif
 
   if (process_type == switches::kRendererProcess) {
+    // Empty is Thor's default Stealth profile. Unknown values fail closed in
+    // the native profile policy and therefore also reduce WebGL identifying
+    // data here. DevHost deliberately preserves truthful developer surfaces.
+    if (browser_command_line.GetSwitchValueASCII("thor-privacy-profile") !=
+        "devhost") {
+      command_line->AppendSwitch(
+          blink::switches::kThorReduceWebGLIdentifyingData);
+    }
+
     content::RenderProcessHost* process =
         content::RenderProcessHost::FromID(child_process_id);
     if (process) {
diff --git a/third_party/blink/common/switches.cc b/third_party/blink/common/switches.cc
index 33781a8..7231121 100644
--- a/third_party/blink/common/switches.cc
+++ b/third_party/blink/common/switches.cc
@@ -61,6 +61,11 @@ const char kDisableZeroCopy[] = "disable-zero-copy";
 // this for the stats to be logged.
 const char kDumpRuntimeCallStats[] = "dump-blink-runtime-call-stats";
 
+// Prevents WebGL from exposing the unmasked GPU vendor and renderer extension.
+// Thor copies this switch only to Stealth and Hardened renderer processes.
+const char kThorReduceWebGLIdentifyingData[] =
+    "thor-reduce-webgl-identifying-data";
+
 // Enable desktop Android scrollbars.
 const char kEnableDesktopAndroidScrollbars[] =
     "enable-desktop-android-scrollbars";
