diff --git a/third_party/blink/renderer/modules/webgl/thor_webgl_privacy.h b/third_party/blink/renderer/modules/webgl/thor_webgl_privacy.h
new file mode 100644
index 0000000..7c2e331
--- /dev/null
+++ b/third_party/blink/renderer/modules/webgl/thor_webgl_privacy.h
@@ -0,0 +1,21 @@
+// Copyright 2026 Thor downstream maintainers
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_THOR_WEBGL_PRIVACY_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_THOR_WEBGL_PRIVACY_H_
+
+#include "base/command_line.h"
+#include "third_party/blink/public/common/switches.h"
+
+namespace blink {
+
+inline bool ThorShouldExposeWebGLDebugRendererInfo(
+    const base::CommandLine& command_line) {
+  return !command_line.HasSwitch(
+      switches::kThorReduceWebGLIdentifyingData);
+}
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_THOR_WEBGL_PRIVACY_H_
diff --git a/third_party/blink/renderer/modules/webgl/thor_webgl_privacy_test.cc b/third_party/blink/renderer/modules/webgl/thor_webgl_privacy_test.cc
new file mode 100644
index 0000000..a2323b9
--- /dev/null
+++ b/third_party/blink/renderer/modules/webgl/thor_webgl_privacy_test.cc
@@ -0,0 +1,24 @@
+// Copyright 2026 Thor downstream maintainers
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/modules/webgl/thor_webgl_privacy.h"
+
+#include "base/command_line.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/switches.h"
+
+namespace blink {
+
+TEST(ThorWebGLPrivacyTest, ExposesDebugRendererWithoutReductionSwitch) {
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  EXPECT_TRUE(ThorShouldExposeWebGLDebugRendererInfo(command_line));
+}
+
+TEST(ThorWebGLPrivacyTest, HidesDebugRendererWithReductionSwitch) {
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  command_line.AppendSwitch(switches::kThorReduceWebGLIdentifyingData);
+  EXPECT_FALSE(ThorShouldExposeWebGLDebugRendererInfo(command_line));
+}
+
+}  // namespace blink
diff --git a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
index 319e17e..d5fbf99 100644
--- a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
+++ b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
@@ -112,6 +112,7 @@
 #include "third_party/blink/renderer/modules/webgl/oes_texture_half_float.h"
 #include "third_party/blink/renderer/modules/webgl/oes_texture_half_float_linear.h"
 #include "third_party/blink/renderer/modules/webgl/oes_vertex_array_object.h"
+#include "third_party/blink/renderer/modules/webgl/thor_webgl_privacy.h"
 #include "third_party/blink/renderer/modules/webgl/webgl_active_info.h"
 #include "third_party/blink/renderer/modules/webgl/webgl_buffer.h"
 #include "third_party/blink/renderer/modules/webgl/webgl_compressed_texture_astc.h"
@@ -3819,6 +3820,11 @@ bool WebGLRenderingContextBase::ExtensionTracker::MatchesName(
 
 bool WebGLRenderingContextBase::ExtensionSupportedAndAllowed(
     const ExtensionTracker* tracker) {
+  if (tracker->MatchesName(WebGLDebugRendererInfo::ExtensionName()) &&
+      !ThorShouldExposeWebGLDebugRendererInfo(
+          *base::CommandLine::ForCurrentProcess())) {
+    return false;
+  }
   if (tracker->Draft() &&
       !RuntimeEnabledFeatures::WebGLDraftExtensionsEnabled())
     return false;
