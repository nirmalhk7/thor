+BrowserWindowInterface* NewThorIdentity(Profile* profile) {
+  Profile* original_profile = profile->GetOriginalProfile();
+  if (original_profile->IsGuestSession() ||
+      original_profile->ShutdownStarted() ||
+      IncognitoModePrefs::GetAvailability(original_profile->GetPrefs()) !=
+          policy::IncognitoModeAvailability::kEnabled) {
+    return nullptr;
+  }
+
+  Profile* identity_profile = original_profile->GetOffTheRecordProfile(
+      Profile::OTRProfileID::CreateUniqueForThorIdentity(),
+      /*create_if_needed=*/true);
+  CHECK(identity_profile->AllowsBrowserWindows());
+
+  BrowserWindowInterface* identity_browser = OpenEmptyWindow(
+      identity_profile, /*should_trigger_session_restore=*/false);
+  if (!identity_browser) {
+    // OTR profiles are memory-only, so failed browser creation must not leave
+    // an orphan in the original profile's in-memory OTR map.
+    ProfileDestroyer::DestroyOTRProfileWhenAppropriate(identity_profile);
+    return nullptr;
+  }
+
+  base::RecordAction(UserMetricsAction("NewThorIdentity"));
+  return identity_browser;
+}
+
 void CloseWindow(BrowserWindowInterface* browser) {
   base::RecordAction(UserMetricsAction("CloseWindow"));
   browser->GetWindow()->Close();
