+IN_PROC_BROWSER_TEST_F(BrowserCommandsTest,
+                       NewThorIdentityUsesUniqueDisposableProfiles) {
+  Profile* original_profile = browser()->profile()->GetOriginalProfile();
+  const size_t initial_otr_count =
+      original_profile->GetAllOffTheRecordProfiles().size();
+
+  EXPECT_TRUE(ExecuteCommand(browser(), IDC_NEW_THOR_IDENTITY));
+  BrowserWindowInterface* first_browser = nullptr;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&first_browser](BrowserWindowInterface* candidate) {
+        Profile* candidate_profile = candidate->GetProfile();
+        if (candidate_profile->IsOffTheRecord() &&
+            candidate_profile->GetOTRProfileID().IsThorIdentity()) {
+          first_browser = candidate;
+          return false;
+        }
+        return true;
+      });
+  ASSERT_TRUE(first_browser);
+  Profile* first_profile = first_browser->GetProfile();
+  const Profile::OTRProfileID first_id = first_profile->GetOTRProfileID();
+  EXPECT_TRUE(first_id.IsThorIdentity());
+  EXPECT_TRUE(first_profile->IsOffTheRecord());
+  EXPECT_FALSE(first_profile->IsPrimaryOTRProfile());
+  EXPECT_FALSE(first_profile->CanUseDiskWhenOffTheRecord());
+  EXPECT_EQ(original_profile, first_profile->GetOriginalProfile());
+  EXPECT_EQ(1, first_browser->GetTabStripModel()->count());
+
+  BrowserWindowInterface* second_browser = NewThorIdentity(original_profile);
+  ASSERT_TRUE(second_browser);
+  Profile* second_profile = second_browser->GetProfile();
+  const Profile::OTRProfileID second_id = second_profile->GetOTRProfileID();
+  EXPECT_TRUE(second_id.IsThorIdentity());
+  EXPECT_NE(first_id, second_id);
+  EXPECT_NE(first_profile, second_profile);
+  EXPECT_EQ(initial_otr_count + 2,
+            original_profile->GetAllOffTheRecordProfiles().size());
+
+  ProfileDestructionWaiter first_waiter(first_profile);
+  first_browser->GetTabStripModel()->CloseAllTabs();
+  first_waiter.Wait();
+  EXPECT_FALSE(original_profile->HasOffTheRecordProfile(first_id));
+  EXPECT_TRUE(original_profile->HasOffTheRecordProfile(second_id));
+
+  ProfileDestructionWaiter second_waiter(second_profile);
+  CloseBrowserSynchronously(second_browser->GetBrowserForMigrationOnly());
+  second_waiter.Wait();
+  EXPECT_FALSE(original_profile->HasOffTheRecordProfile(second_id));
+  EXPECT_EQ(initial_otr_count,
+            original_profile->GetAllOffTheRecordProfiles().size());
+}
+
+IN_PROC_BROWSER_TEST_F(BrowserCommandsTest,
+                       NewThorIdentityHonorsIncognitoPolicy) {
+  Profile* original_profile = browser()->profile()->GetOriginalProfile();
+  const size_t initial_otr_count =
+      original_profile->GetAllOffTheRecordProfiles().size();
+  IncognitoModePrefs::SetAvailability(
+      original_profile->GetPrefs(),
+      policy::IncognitoModeAvailability::kDisabled);
+
+  EXPECT_FALSE(IsCommandEnabled(browser(), IDC_NEW_THOR_IDENTITY));
+  EXPECT_EQ(nullptr, NewThorIdentity(original_profile));
+  EXPECT_EQ(initial_otr_count,
+            original_profile->GetAllOffTheRecordProfiles().size());
+
+  IncognitoModePrefs::SetAvailability(
+      original_profile->GetPrefs(),
+      policy::IncognitoModeAvailability::kForced);
+  EXPECT_FALSE(IsCommandEnabled(browser(), IDC_NEW_THOR_IDENTITY));
+  EXPECT_EQ(nullptr, NewThorIdentity(original_profile));
+  EXPECT_EQ(initial_otr_count,
+            original_profile->GetAllOffTheRecordProfiles().size());
+}
