+// Copyright 2026 Thor downstream maintainers
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_THOR_PRIVACY_THOR_URL_CLEANUP_THROTTLE_H_
+#define CHROME_BROWSER_THOR_PRIVACY_THOR_URL_CLEANUP_THROTTLE_H_
+
+#include <memory>
+
+#include "third_party/blink/public/common/loader/url_loader_throttle.h"
+#include "url/gurl.h"
+
+namespace network {
+struct ResourceRequest;
+}  // namespace network
+
+namespace thor::privacy {
+
+// Removes a conservative, static set of campaign identifiers from HTTP(S)
+// URLs. This intentionally fails open for signed and authorization callback
+// query strings and is not a general-purpose filter-list engine.
+GURL CleanTrackingParameters(const GURL& url);
+
+class ThorURLCleanupThrottle final : public blink::URLLoaderThrottle {
+ public:
+  static std::unique_ptr<ThorURLCleanupThrottle> MaybeCreate(
+      const network::ResourceRequest& request);
+
+  ThorURLCleanupThrottle();
+  ThorURLCleanupThrottle(const ThorURLCleanupThrottle&) = delete;
+  ThorURLCleanupThrottle& operator=(const ThorURLCleanupThrottle&) = delete;
+  ~ThorURLCleanupThrottle() override;
+
+  void WillStartRequest(network::ResourceRequest* request,
+                        bool* defer) override;
+  void WillRedirectRequest(
+      net::RedirectInfo* redirect_info,
+      const network::mojom::URLResponseHead& response_head,
+      bool* defer,
+      network::HttpRequestHeadersUpdateParams* headers_update_params) override;
+};
+
+}  // namespace thor::privacy
+
+#endif  // CHROME_BROWSER_THOR_PRIVACY_THOR_URL_CLEANUP_THROTTLE_H_
diff --git a/chrome/browser/thor/privacy/thor_url_cleanup_throttle_unittest.cc b/chrome/browser/thor/privacy/thor_url_cleanup_throttle_unittest.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/thor/privacy/thor_url_cleanup_throttle_unittest.cc
@@ -0,0 +1,78 @@
+// Copyright 2026 Thor downstream maintainers
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/thor/privacy/thor_url_cleanup_throttle.h"
+
+#include "services/network/public/cpp/resource_request.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace thor::privacy {
+
+TEST(ThorURLCleanupThrottleTest, RemovesKnownParametersAndPreservesFragment) {
+  EXPECT_EQ(
+      "https://example.test/path?keep=1#fragment",
+      CleanTrackingParameters(GURL(
+          "https://example.test/path?utm_source=news&keep=1&FBCLID=id#fragment"))
+          .spec());
+}
+
+TEST(ThorURLCleanupThrottleTest, RemovesDuplicateAndCaseVariantParameters) {
+  EXPECT_EQ("https://example.test/",
+            CleanTrackingParameters(GURL(
+                "https://example.test/?gclid=one&GCLID=two&utm_medium=email"))
+                .spec());
+}
+
+TEST(ThorURLCleanupThrottleTest, PreservesUnknownAndNonHttpParameters) {
+  const GURL unknown("https://example.test/?campaign=one&source=two");
+  const GURL non_http("file:///tmp/test?utm_source=news");
+  EXPECT_EQ(unknown, CleanTrackingParameters(unknown));
+  EXPECT_EQ(non_http, CleanTrackingParameters(non_http));
+}
+
+TEST(ThorURLCleanupThrottleTest, FailsOpenForSignedAndAuthorizationURLs) {
+  const GURL signed_url(
+      "https://example.test/?utm_source=news&X-Amz-Signature=abc");
+  const GURL oauth_url(
+      "https://example.test/callback?utm_source=news&code=abc&state=xyz");
+  EXPECT_EQ(signed_url, CleanTrackingParameters(signed_url));
+  EXPECT_EQ(oauth_url, CleanTrackingParameters(oauth_url));
+}
+
+TEST(ThorURLCleanupThrottleTest, IsIdempotent) {
+  const GURL original(
+      "https://example.test/?utm_campaign=sale&keep=one&keep=two");
+  const GURL cleaned = CleanTrackingParameters(original);
+  EXPECT_EQ(cleaned, CleanTrackingParameters(cleaned));
+}
+
+TEST(ThorURLCleanupThrottleTest, CreatesOnlyForOutermostGetNavigation) {
+  network::ResourceRequest request;
+  request.url = GURL("https://example.test/?gclid=id");
+  request.method = "GET";
+  request.is_outermost_main_frame = true;
+  EXPECT_TRUE(ThorURLCleanupThrottle::MaybeCreate(request));
+
+  request.is_outermost_main_frame = false;
+  EXPECT_FALSE(ThorURLCleanupThrottle::MaybeCreate(request));
+
+  request.is_outermost_main_frame = true;
+  request.method = "POST";
+  EXPECT_FALSE(ThorURLCleanupThrottle::MaybeCreate(request));
+}
+
+TEST(ThorURLCleanupThrottleTest, InitialRequestUsesCleanedURL) {
+  network::ResourceRequest request;
+  request.url = GURL("https://example.test/?utm_source=news&keep=1");
+  request.method = "GET";
+  request.is_outermost_main_frame = true;
+  auto throttle = ThorURLCleanupThrottle::MaybeCreate(request);
+  ASSERT_TRUE(throttle);
+  bool defer = false;
+  throttle->WillStartRequest(&request, &defer);
+  EXPECT_FALSE(defer);
+  EXPECT_EQ("https://example.test/?keep=1", request.url.spec());
+}
+
+}  // namespace thor::privacy
