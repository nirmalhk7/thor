diff --git a/chrome/browser/thor/privacy/thor_url_cleanup_throttle.cc b/chrome/browser/thor/privacy/thor_url_cleanup_throttle.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/thor/privacy/thor_url_cleanup_throttle.cc
@@ -0,0 +1,141 @@
+// Copyright 2026 Thor downstream maintainers
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/thor/privacy/thor_url_cleanup_throttle.h"
+
+#include <array>
+#include <string>
+#include <string_view>
+
+#include "base/strings/string_util.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/third_party/mozilla/url_parse.h"
+#include "url/url_canon.h"
+
+namespace thor::privacy {
+
+namespace {
+
+constexpr std::array<std::string_view, 14> kTrackingParameters = {
+    "dclid",        "fbclid",              "gclid",
+    "mc_cid",       "mc_eid",              "msclkid",
+    "utm_campaign", "utm_content",         "utm_creative_format",
+    "utm_id",       "utm_marketing_tactic", "utm_medium",
+    "utm_source",   "utm_term",
+};
+
+// Query cleanup must not invalidate common signed or authorization callback
+// URLs. Presence of one of these keys makes the entire query fail open.
+constexpr std::array<std::string_view, 14> kSensitiveParameters = {
+    "auth",             "authorization",    "code",
+    "expires",          "key-pair-id",      "policy",
+    "samlrequest",      "samlresponse",     "sig",
+    "signature",        "state",            "token",
+    "x-amz-signature",  "x-goog-signature",
+};
+
+template <size_t N>
+bool MatchesParameter(
+    std::string_view candidate,
+    const std::array<std::string_view, N>& parameter_names) {
+  for (std::string_view parameter_name : parameter_names) {
+    if (base::EqualsCaseInsensitiveASCII(candidate, parameter_name)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool HasSensitiveParameter(const GURL& url) {
+  const std::string_view input = url.query();
+  url::Component cursor(0, input.size());
+  url::Component key_range;
+  url::Component value_range;
+  while (url::ExtractQueryKeyValue(input, &cursor, &key_range, &value_range)) {
+    const std::string_view key =
+        input.substr(key_range.begin, key_range.len);
+    if (MatchesParameter(key, kSensitiveParameters)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+GURL CleanTrackingParameters(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || !url.has_query() ||
+      HasSensitiveParameter(url)) {
+    return url;
+  }
+
+  const std::string_view input = url.query();
+  url::Component cursor(0, input.size());
+  url::Component key_range;
+  url::Component value_range;
+  std::string output;
+  bool removed_parameter = false;
+
+  while (url::ExtractQueryKeyValue(input, &cursor, &key_range, &value_range)) {
+    const std::string_view key =
+        input.substr(key_range.begin, key_range.len);
+    if (MatchesParameter(key, kTrackingParameters)) {
+      removed_parameter = true;
+      continue;
+    }
+
+    if (!output.empty()) {
+      output.push_back('&');
+    }
+    output.append(input.substr(key_range.begin,
+                               value_range.end() - key_range.begin));
+  }
+
+  if (!removed_parameter) {
+    return url;
+  }
+
+  GURL::Replacements replacements;
+  if (output.empty()) {
+    replacements.ClearQuery();
+  } else {
+    replacements.SetQueryStr(output);
+  }
+  return url.ReplaceComponents(replacements);
+}
+
+// static
+std::unique_ptr<ThorURLCleanupThrottle>
+ThorURLCleanupThrottle::MaybeCreate(const network::ResourceRequest& request) {
+  if (!request.is_outermost_main_frame || request.method != "GET") {
+    return nullptr;
+  }
+  return std::make_unique<ThorURLCleanupThrottle>();
+}
+
+ThorURLCleanupThrottle::ThorURLCleanupThrottle() = default;
+ThorURLCleanupThrottle::~ThorURLCleanupThrottle() = default;
+
+void ThorURLCleanupThrottle::WillStartRequest(
+    network::ResourceRequest* request,
+    bool* /* defer */) {
+  request->url = CleanTrackingParameters(request->url);
+}
+
+void ThorURLCleanupThrottle::WillRedirectRequest(
+    net::RedirectInfo* redirect_info,
+    const network::mojom::URLResponseHead& /* response_head */,
+    bool* /* defer */,
+    network::HttpRequestHeadersUpdateParams* /* headers_update_params */) {
+  if (redirect_info->new_method != "GET") {
+    return;
+  }
+  // Query-only replacement necessarily preserves the redirect origin, as
+  // required by blink::URLLoaderThrottle.
+  redirect_info->new_url = CleanTrackingParameters(redirect_info->new_url);
+}
+
+}  // namespace thor::privacy
