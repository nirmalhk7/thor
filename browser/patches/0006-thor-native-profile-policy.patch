+// Copyright 2026 Thor downstream maintainers
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_CONTENT_SETTINGS_THOR_PRIVACY_PROFILE_POLICY_H_
+#define CHROME_BROWSER_CONTENT_SETTINGS_THOR_PRIVACY_PROFILE_POLICY_H_
+
+#include <string_view>
+
+#include "components/content_settings/core/common/content_settings.h"
+
+class HostContentSettingsMap;
+
+namespace thor::privacy {
+
+enum class ThorPrivacyProfileMode {
+  kDevHost,
+  kStealth,
+  kHardened,
+};
+
+struct ThorPrivacyProfileDefaults {
+  ContentSetting dangerous_api_default;
+  ContentSetting javascript_jit_default;
+};
+
+// Empty means Thor's default Stealth profile. Unknown values fail closed to
+// Hardened instead of silently weakening policy.
+ThorPrivacyProfileMode ParseThorPrivacyProfileMode(std::string_view value);
+
+ThorPrivacyProfileDefaults GetThorPrivacyProfileDefaults(
+    ThorPrivacyProfileMode mode);
+
+// Applies inherited user-level defaults. Chromium's managed-policy provider
+// remains higher priority, and explicit per-site settings remain available.
+void ApplyThorPrivacyProfilePolicy(HostContentSettingsMap* settings_map);
+
+}  // namespace thor::privacy
+
+#endif  // CHROME_BROWSER_CONTENT_SETTINGS_THOR_PRIVACY_PROFILE_POLICY_H_
diff --git a/chrome/browser/content_settings/thor_privacy_profile_policy_unittest.cc b/chrome/browser/content_settings/thor_privacy_profile_policy_unittest.cc
new file mode 100644
index 0000000..0b12ce4
--- /dev/null
+++ b/chrome/browser/content_settings/thor_privacy_profile_policy_unittest.cc
@@ -0,0 +1,44 @@
+// Copyright 2026 Thor downstream maintainers
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/content_settings/thor_privacy_profile_policy.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace thor::privacy {
+
+TEST(ThorPrivacyProfilePolicyTest, ParsesSupportedModesAndDefaultsToStealth) {
+  EXPECT_EQ(ThorPrivacyProfileMode::kDevHost,
+            ParseThorPrivacyProfileMode("devhost"));
+  EXPECT_EQ(ThorPrivacyProfileMode::kStealth,
+            ParseThorPrivacyProfileMode("stealth"));
+  EXPECT_EQ(ThorPrivacyProfileMode::kStealth,
+            ParseThorPrivacyProfileMode(""));
+  EXPECT_EQ(ThorPrivacyProfileMode::kHardened,
+            ParseThorPrivacyProfileMode("hardened"));
+}
+
+TEST(ThorPrivacyProfilePolicyTest, UnknownModeFailsClosed) {
+  EXPECT_EQ(ThorPrivacyProfileMode::kHardened,
+            ParseThorPrivacyProfileMode("unsupported"));
+}
+
+TEST(ThorPrivacyProfilePolicyTest, ProfilesHaveDistinctNativeDefaults) {
+  const auto devhost =
+      GetThorPrivacyProfileDefaults(ThorPrivacyProfileMode::kDevHost);
+  EXPECT_EQ(CONTENT_SETTING_ASK, devhost.dangerous_api_default);
+  EXPECT_EQ(CONTENT_SETTING_ALLOW, devhost.javascript_jit_default);
+
+  const auto stealth =
+      GetThorPrivacyProfileDefaults(ThorPrivacyProfileMode::kStealth);
+  EXPECT_EQ(CONTENT_SETTING_BLOCK, stealth.dangerous_api_default);
+  EXPECT_EQ(CONTENT_SETTING_ALLOW, stealth.javascript_jit_default);
+
+  const auto hardened =
+      GetThorPrivacyProfileDefaults(ThorPrivacyProfileMode::kHardened);
+  EXPECT_EQ(CONTENT_SETTING_BLOCK, hardened.dangerous_api_default);
+  EXPECT_EQ(CONTENT_SETTING_BLOCK, hardened.javascript_jit_default);
+}
+
+}  // namespace thor::privacy
