diff --git a/chrome/browser/content_settings/thor_privacy_profile_policy.cc b/chrome/browser/content_settings/thor_privacy_profile_policy.cc
new file mode 100644
index 0000000..ac05ebc
--- /dev/null
+++ b/chrome/browser/content_settings/thor_privacy_profile_policy.cc
@@ -0,0 +1,78 @@
+// Copyright 2026 Thor downstream maintainers
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/content_settings/thor_privacy_profile_policy.h"
+
+#include <array>
+#include <string>
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+
+namespace thor::privacy {
+namespace {
+
+constexpr char kThorPrivacyProfileSwitch[] = "thor-privacy-profile";
+
+constexpr std::array<ContentSettingsType, 8> kDangerousApiSettings = {
+    ContentSettingsType::MIDI_SYSEX,
+    ContentSettingsType::BLUETOOTH_GUARD,
+    ContentSettingsType::SENSORS,
+    ContentSettingsType::USB_GUARD,
+    ContentSettingsType::SERIAL_GUARD,
+    ContentSettingsType::HID_GUARD,
+    ContentSettingsType::LOCAL_FONTS,
+    ContentSettingsType::IDLE_DETECTION,
+};
+
+}  // namespace
+
+ThorPrivacyProfileMode ParseThorPrivacyProfileMode(std::string_view value) {
+  if (value.empty() || value == "stealth") {
+    return ThorPrivacyProfileMode::kStealth;
+  }
+  if (value == "devhost") {
+    return ThorPrivacyProfileMode::kDevHost;
+  }
+  if (value == "hardened") {
+    return ThorPrivacyProfileMode::kHardened;
+  }
+  return ThorPrivacyProfileMode::kHardened;
+}
+
+ThorPrivacyProfileDefaults GetThorPrivacyProfileDefaults(
+    ThorPrivacyProfileMode mode) {
+  if (mode == ThorPrivacyProfileMode::kDevHost) {
+    return {CONTENT_SETTING_ASK, CONTENT_SETTING_ALLOW};
+  }
+  if (mode == ThorPrivacyProfileMode::kStealth) {
+    return {CONTENT_SETTING_BLOCK, CONTENT_SETTING_ALLOW};
+  }
+  return {CONTENT_SETTING_BLOCK, CONTENT_SETTING_BLOCK};
+}
+
+void ApplyThorPrivacyProfilePolicy(HostContentSettingsMap* settings_map) {
+  CHECK(settings_map);
+  const std::string value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          kThorPrivacyProfileSwitch);
+  const ThorPrivacyProfileDefaults defaults =
+      GetThorPrivacyProfileDefaults(ParseThorPrivacyProfileMode(value));
+
+  for (ContentSettingsType type : kDangerousApiSettings) {
+    settings_map->SetDefaultContentSetting(type,
+                                           defaults.dangerous_api_default);
+  }
+  // Direct Sockets has no prompt state. Keep it denied by default in every
+  // profile; DevHost can grant an explicit per-site exception.
+  settings_map->SetDefaultContentSetting(ContentSettingsType::DIRECT_SOCKETS,
+                                         CONTENT_SETTING_BLOCK);
+  settings_map->SetDefaultContentSetting(
+      ContentSettingsType::JAVASCRIPT_JIT,
+      defaults.javascript_jit_default);
+}
+
+}  // namespace thor::privacy
