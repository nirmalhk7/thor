From c583827a354674180dc8856eb65aeb3f0afa5ee9 Mon Sep 17 00:00:00 2001
From: Thor downstream maintainers
Date: Fri, 31 Jul 2026 00:00:00 -0600
Subject: [PATCH 3/3] Add native Global Privacy Control
X-Upstream-Commit: 9f6110d690bed64b39bb85adf99cd5343924cdff
X-Upstream-License: Chromium BSD-style license (LICENSE)
X-Adaptation: Backport upstream GPC surfaces to Chromium 151 and replace
 global feature-only behavior with a managed, per-profile preference.
---
diff --git a/chrome/browser/chrome_do_not_track_browsertest.cc b/chrome/browser/chrome_do_not_track_browsertest.cc
index 05c036a3c4e8fb6eb71832d42ee281d1e01b098b..cb7f3d4bb223f6c28c198ec1447a751ba32357ab 100644
--- a/chrome/browser/chrome_do_not_track_browsertest.cc
+++ b/chrome/browser/chrome_do_not_track_browsertest.cc
@@ -26,6 +26,11 @@ class ChromeDoNotTrackTest : public InProcessBrowserTest {
     prefs->SetBoolean(prefs::kEnableDoNotTrack, enabled);
   }
 
+  void SetEnableGlobalPrivacyControl(bool enabled) {
+    PrefService* prefs = browser()->profile()->GetPrefs();
+    prefs->SetBoolean(prefs::kEnableGlobalPrivacyControl, enabled);
+  }
+
   void ExpectPageTextEq(const std::string& expected_content) {
     EXPECT_EQ(expected_content,
               EvalJs(browser()->tab_strip_model()->GetActiveWebContents(),
@@ -35,6 +40,25 @@ class ChromeDoNotTrackTest : public InProcessBrowserTest {
   content::WebContents* GetWebContents() {
     return browser()->tab_strip_model()->GetActiveWebContents();
   }
+
+  bool ReadGlobalPrivacyControlFromWorker() {
+    return EvalJs(GetWebContents(), R"(
+      new Promise((resolve, reject) => {
+        const script = new Blob(
+            ['postMessage(navigator.globalPrivacyControl === true)'],
+            {type: 'application/javascript'});
+        const url = URL.createObjectURL(script);
+        const worker = new Worker(url);
+        worker.onmessage = event => {
+          worker.terminate();
+          URL.revokeObjectURL(url);
+          resolve(event.data);
+        };
+        worker.onerror = reject;
+      })
+    )")
+        .ExtractBool();
+  }
 };
 
 IN_PROC_BROWSER_TEST_F(ChromeDoNotTrackTest, NotEnabled) {
@@ -59,6 +83,53 @@ IN_PROC_BROWSER_TEST_F(ChromeDoNotTrackTest, Enabled) {
   ExpectPageTextEq("1");
 }
 
+IN_PROC_BROWSER_TEST_F(ChromeDoNotTrackTest, GlobalPrivacyControlDisabled) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  SetEnableGlobalPrivacyControl(false);
+
+  GURL url = embedded_test_server()->GetURL("/echoheader?Sec-GPC");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  EXPECT_FALSE(GetWebContents()
+                   ->GetMutableRendererPrefs()
+                   ->enable_global_privacy_control);
+  ExpectPageTextEq("None");
+  EXPECT_FALSE(EvalJs(GetWebContents(),
+                      "navigator.globalPrivacyControl === true")
+                   .ExtractBool());
+  EXPECT_FALSE(ReadGlobalPrivacyControlFromWorker());
+}
+
+IN_PROC_BROWSER_TEST_F(ChromeDoNotTrackTest,
+                       GlobalPrivacyControlEnabledAcrossRedirectAndWorkers) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  SetEnableGlobalPrivacyControl(true);
+
+  GURL redirect = embedded_test_server()->GetURL(
+      "/server-redirect?/echoheader?Sec-GPC");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), redirect));
+  EXPECT_TRUE(GetWebContents()
+                  ->GetMutableRendererPrefs()
+                  ->enable_global_privacy_control);
+  ExpectPageTextEq("1");
+  EXPECT_TRUE(EvalJs(GetWebContents(),
+                     "navigator.globalPrivacyControl === true")
+                  .ExtractBool());
+  EXPECT_TRUE(ReadGlobalPrivacyControlFromWorker());
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(),
+      embedded_test_server()->GetURL("/workers/fetch_from_worker.html")));
+  EXPECT_EQ("1", EvalJs(GetWebContents(),
+                         "fetch_from_worker('/echoheader?Sec-GPC');"));
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL(
+                     "/workers/fetch_from_service_worker.html")));
+  EXPECT_EQ("ready", EvalJs(GetWebContents(), "setup();"));
+  EXPECT_EQ("1", EvalJs(GetWebContents(),
+                         "fetch_from_service_worker('/echoheader?Sec-GPC');"));
+}
+
 // Checks that the DNT header is preserved when fetching from a dedicated
 // worker.
 IN_PROC_BROWSER_TEST_F(ChromeDoNotTrackTest, FetchFromWorker) {
